# Copy to .env.local for local work, or add these in Vercel under Settings, Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never give this one the NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
# Optional but strongly advised: without it GitHub allows only 60 requests an hour.
GITHUB_TOKEN=
# Optional model overrides.
CLAUDE_SCAN_MODEL=
CLAUDE_GRADE_MODEL=
